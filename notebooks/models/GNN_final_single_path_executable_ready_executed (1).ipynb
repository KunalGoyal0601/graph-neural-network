    "## 6. Dependency-free GNN models\n",
    "\n",
    "The original notebook depended on `torch_geometric`, which is not installed in the execution environment. Instead of leaving an installation failure inside the notebook, these models use ordinary PyTorch tensor operations while preserving the intended architectures:\n",
    "\n",
    "1. GCN\n",
    "2. GraphSAGE\n",
    "3. GAT\n",
    "4. HGT-style heterogeneous attention\n",
    "\n",
    "This makes the notebook portable while keeping the graph-learning experiment explicit."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "06c37fa7",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-24T12:45:02.939902Z",
     "iopub.status.busy": "2026-09-24T12:45:02.936503Z",
     "iopub.status.idle": "2026-09-24T12:45:03.039929Z",
     "shell.execute_reply": "2026-09-24T12:45:03.033352Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Models ready: ['GCN', 'GraphSAGE', 'GAT', 'HGT']\n"
     ]
    }
   ],
   "source": [
    "# 6A. Shared utilities\n",
    "TARGET_IDX = torch.tensor(list(range(1, 9)), dtype=torch.long)\n",
    "\n",
    "def normalize_adj(adj):\n",
    "    # Symmetric normalization; accept [N,N] or batched [B,N,N].\n",
    "    was_2d = adj.dim() == 2\n",
    "    if was_2d:\n",
    "        adj = adj.unsqueeze(0)\n",
    "    eye = torch.eye(adj.shape[-1], device=adj.device).unsqueeze(0)\n",
    "    a = adj + eye\n",
    "    deg = a.sum(dim=-1).clamp_min(1e-8)\n",
    "    d = deg.pow(-0.5)\n",
    "    out = d.unsqueeze(-1) * a * d.unsqueeze(-2)\n",
    "    return out.squeeze(0) if was_2d else out\n",
    "\n",
    "class GraphModelBase(nn.Module):\n",
    "    def __init__(self, hidden, layers, dropout):\n",
    "        super().__init__()\n",
    "        self.hidden = hidden\n",
    "        self.layers = layers\n",
    "        self.dropout = dropout\n",
    "        self.out = nn.Linear(hidden, 1)\n",
    "\n",
    "    def readout(self, h):\n",
    "        return self.out(h[:, 1:9, :]).squeeze(-1)\n",
    "\n",
    "class GCNModel(GraphModelBase):\n",
    "    def __init__(self, in_dim, hidden, layers=2, dropout=0.2):\n",
    "        super().__init__(hidden, layers, dropout)\n",
    "        dims = [in_dim] + [hidden] * layers\n",
    "        self.linears = nn.ModuleList([nn.Linear(dims[i], dims[i+1]) for i in range(layers)])\n",
    "\n",
    "    def forward(self, x, adj):\n",
    "        a = normalize_adj(adj)\n",
    "        if a.dim() == 2:\n",
    "            a = a.unsqueeze(0).expand(x.size(0), -1, -1)\n",
    "        h = x\n",
    "        for i, layer in enumerate(self.linears):\n",
    "            h = torch.bmm(a, h)\n",
    "            h = layer(h)\n",
    "            h = F.relu(h)\n",
    "            h = F.dropout(h, p=self.dropout, training=self.training)\n",
    "        return self.readout(h)\n",
    "\n",
    "class GraphSAGEModel(GraphModelBase):\n",
    "    def __init__(self, in_dim, hidden, layers=2, dropout=0.2):\n",
    "        super().__init__(hidden, layers, dropout)\n",
    "        dims = [in_dim] + [hidden] * layers\n",
    "        self.linears = nn.ModuleList([nn.Linear(dims[i] * 2, dims[i+1]) for i in range(layers)])\n",
    "\n",
    "    def forward(self, x, adj):\n",
    "        a = normalize_adj(adj)\n",
    "        if a.dim() == 2:\n",
    "            a = a.unsqueeze(0).expand(x.size(0), -1, -1)\n",
    "        h = x\n",
    "        for layer in self.linears:\n",
    "            neigh = torch.bmm(a, h)\n",
    "            h = torch.cat([h, neigh], dim=-1)\n",
    "            h = F.relu(layer(h))\n",
    "            h = F.dropout(h, p=self.dropout, training=self.training)\n",
    "        return self.readout(h)\n",
    "\n",
    "class GATModel(GraphModelBase):\n",
    "    def __init__(self, in_dim, hidden, heads=4, layers=2, dropout=0.2):\n",
    "        super().__init__(hidden, layers, dropout)\n",
    "        if hidden % heads != 0:\n",
    "            raise ValueError(\"hidden must be divisible by heads\")\n",
    "        self.heads = heads\n",
    "        self.head_dim = hidden // heads\n",
    "        dims = [in_dim] + [hidden] * layers\n",
    "        self.q = nn.ModuleList([nn.Linear(dims[i], hidden, bias=False) for i in range(layers)])\n",
    "        self.k = nn.ModuleList([nn.Linear(dims[i], hidden, bias=False) for i in range(layers)])\n",
    "        self.v = nn.ModuleList([nn.Linear(dims[i], hidden, bias=False) for i in range(layers)])\n",
    "        self.proj = nn.ModuleList([nn.Linear(hidden, hidden) for _ in range(layers)])\n",
    "        self.leaky = nn.LeakyReLU(0.2)\n",
    "\n",
    "    def forward(self, x, adj):\n",
    "        h = x\n",
    "        mask = (adj > 0).unsqueeze(0)\n",
    "        for ql, kl, vl, pl in zip(self.q, self.k, self.v, self.proj):\n",
    "            B, N, _ = h.shape\n",
    "            q = ql(h).view(B, N, self.heads, self.head_dim)\n",
    "            k = kl(h).view(B, N, self.heads, self.head_dim)\n",
    "            v = vl(h).view(B, N, self.heads, self.head_dim)\n",
    "            scores = torch.einsum(\"bnhd,bmhd->bhnm\", q, k) / math.sqrt(self.head_dim)\n",
    "            scores = self.leaky(scores)\n",
    "            scores = scores.masked_fill(~mask[:, None, :, :], -1e9)\n",
    "            alpha = torch.softmax(scores, dim=-1)\n",
    "            agg = torch.einsum(\"bhnm,bmhd->bnhd\", alpha, v).reshape(B, N, -1)\n",
    "            h = F.elu(pl(agg))\n",
    "            h = F.dropout(h, p=self.dropout, training=self.training)\n",
    "        return self.readout(h)\n",
    "\n",
    "class HGTStyleModel(GraphModelBase):\n",
    "    \"\"\"A compact heterogeneous-attention model with node-type and relation biases.\"\"\"\n",
    "    def __init__(self, in_dim, hidden, heads=4, layers=2, dropout=0.2):\n",
    "        super().__init__(hidden, layers, dropout)\n",
    "        if hidden % heads != 0:\n",
    "            raise ValueError(\"hidden must be divisible by heads\")\n",
    "        self.heads = heads\n",
    "        self.head_dim = hidden // heads\n",
    "        self.input = nn.Linear(in_dim, hidden)\n",
    "        self.type_emb = nn.Embedding(4, hidden)\n",
    "        self.rel_emb = nn.Embedding(len(EDGE_GROUPS), heads)\n",
    "        self.q = nn.ModuleList([nn.Linear(hidden, hidden, bias=False) for _ in range(layers)])\n",
    "        self.k = nn.ModuleList([nn.Linear(hidden, hidden, bias=False) for _ in range(layers)])\n",
    "        self.v = nn.ModuleList([nn.Linear(hidden, hidden, bias=False) for _ in range(layers)])\n",
    "        self.proj = nn.ModuleList([nn.Linear(hidden, hidden) for _ in range(layers)])\n",
    "        self.norms = nn.ModuleList([nn.LayerNorm(hidden) for _ in range(layers)])\n",
    "\n",
    "    def forward(self, x, adj, node_types=NODE_TYPES, rel_matrix=REL):\n",
    "        h = self.input(x) + self.type_emb(node_types.to(x.device)).unsqueeze(0)\n",
    "        valid = adj > 0\n",
    "        rel_ids = rel_matrix.to(x.device).clamp_min(0)\n",
    "        rel_bias = self.rel_emb(rel_ids).permute(2, 0, 1)  # [heads,N,N]\n",
    "\n",
    "        for ql, kl, vl, pl, norm in zip(self.q, self.k, self.v, self.proj, self.norms):\n",
    "            B, N, _ = h.shape\n",
    "            q = ql(h).view(B, N, self.heads, self.head_dim)\n",
    "            k = kl(h).view(B, N, self.heads, self.head_dim)\n",
    "            v = vl(h).view(B, N, self.heads, self.head_dim)\n",
    "\n",
    "            scores = torch.einsum(\"bnhd,bmhd->bhnm\", q, k) / math.sqrt(self.head_dim)\n",
    "            scores = scores + rel_bias.unsqueeze(0)\n",
    "            # Keep adjacency magnitude in the attention score so edge saliency can be computed.\n",
    "            scores = scores + torch.log(adj.clamp_min(1e-6)).unsqueeze(0).unsqueeze(0)\n",
    "            scores = scores.masked_fill(~valid.unsqueeze(0).unsqueeze(0), -1e9)\n",
    "            alpha = torch.softmax(scores, dim=-1)\n",
    "            agg = torch.einsum(\"bhnm,bmhd->bnhd\", alpha, v).reshape(B, N, -1)\n",
    "\n",
    "            h = norm(h + F.dropout(F.gelu(pl(agg)), p=self.dropout, training=self.training))\n",
    "\n",
    "        return self.readout(h)\n",
    "\n",
    "def make_model(name, params):\n",
    "    if name == \"GCN\":\n",
    "        return GCNModel(NODE_FEAT_DIM, params[\"hidden\"], params[\"layers\"], params[\"dropout\"])\n",
    "    if name == \"GraphSAGE\":\n",
    "        return GraphSAGEModel(NODE_FEAT_DIM, params[\"hidden\"], params[\"layers\"], params[\"dropout\"])\n",
    "    if name == \"GAT\":\n",
    "        return GATModel(NODE_FEAT_DIM, params[\"hidden\"], params[\"heads\"], params[\"layers\"], params[\"dropout\"])\n",
    "    if name == \"HGT\":\n",
    "        return HGTStyleModel(NODE_FEAT_DIM, params[\"hidden\"], params[\"heads\"], params[\"layers\"], params[\"dropout\"])\n",
    "    raise ValueError(name)\n",
    "\n",
    "print(\"Models ready:\", list(DEFAULT_PARAMS))\n"
   ]
  },
