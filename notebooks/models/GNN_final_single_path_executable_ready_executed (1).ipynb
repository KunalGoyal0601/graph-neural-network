   "source": [
    "# 9A. Feature saliency per target sector\n",
    "FEATURE_LABELS = [\"Base\", \"Return\", \"LogRet\", \"MA30\", \"Volatility\", \"Momentum\", \"RS\", \"RSI\", \"Drawdown\", \"PriceMA30\"]\n",
    "NODE_LABELS = [labels[i] for i in range(N_NODES)]\n",
    "\n",
    "def feature_saliency(model, X_subset, target_idx=0):\n",
    "    model.eval()\n",
    "    x = torch.tensor(X_subset, dtype=torch.float32, device=DEVICE, requires_grad=True)\n",
    "    if isinstance(model, HGTStyleModel):\n",
    "        logits = model(x, A_base, NODE_TYPES.to(DEVICE), REL.to(DEVICE))\n",
    "    else:\n",
    "        logits = model(x, A_base)\n",
    "\n",
    "    score = logits[:, target_idx].mean()\n",
    "    model.zero_grad(set_to_none=True)\n",
    "    score.backward()\n",
    "\n",
    "    sal = (x.grad.abs() * x.abs()).mean(dim=0).detach().cpu().numpy()\n",
    "    return sal\n",
    "\n",
    "# Use a compact test subset for explanation speed.\n",
    "explain_X = X_test[:min(256, len(X_test))]\n",
    "\n",
    "best_model_name = max(results, key=lambda k: results[k][\"auc\"])\n",
    "best_model = final_models[best_model_name]\n",
    "sal = feature_saliency(best_model, explain_X, target_idx=0)\n",
    "\n",
    "# Sector-node feature importance plot for the eight predicted sectors.\n",
    "sector_sal = sal[1:9, :10]\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(16, 8))\n",
    "for i, ax in enumerate(axes.ravel()):\n",
    "    order = np.argsort(sector_sal[i])\n",
    "    ax.barh(np.array(FEATURE_LABELS)[order], sector_sal[i][order])\n",
    "    ax.set_title(PRED_SECTORS[i].replace(\"NIFTY_\", \"\"))\n",
    "    ax.set_xlabel(\"Gradient × input saliency\")\n",
    "    ax.grid(axis=\"x\", alpha=0.25)\n",
    "fig.suptitle(f\"Feature Importance per Sector — {best_model_name} (gradient saliency)\", fontweight=\"bold\")\n",
    "fig.tight_layout()\n",
    "plt.show()\n"
   ]
