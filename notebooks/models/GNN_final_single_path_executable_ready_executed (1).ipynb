    "# 8B. Evaluation\n",
    "def predict(model, X):\n",
    "    model.eval()\n",
    "    probs = []\n",
    "    with torch.no_grad():\n",
    "        for start in range(0, len(X), BATCH_SIZE):\n",
    "            xb = torch.tensor(X[start:start+BATCH_SIZE], dtype=torch.float32, device=DEVICE)\n",
    "            if isinstance(model, HGTStyleModel):\n",
    "                logits = model(xb, A_base, NODE_TYPES.to(DEVICE), REL.to(DEVICE))\n",
    "            else:\n",
    "                logits = model(xb, A_base)\n",
    "            probs.append(torch.sigmoid(logits).cpu().numpy())\n",
    "    return np.vstack(probs)\n",
    "\n",
    "def safe_auc(y_true, y_prob):\n",
    "    try:\n",
    "        return roc_auc_score(y_true, y_prob)\n",
    "    except ValueError:\n",
    "        return np.nan\n",
    "\n",
    "def metric_bundle(y_true, probs):\n",
    "    preds = (probs >= 0.5).astype(int)\n",
    "    acc = accuracy_score(y_true.reshape(-1), preds.reshape(-1))\n",
    "    precision = precision_score(y_true.reshape(-1), preds.reshape(-1), zero_division=0)\n",
    "    recall = recall_score(y_true.reshape(-1), preds.reshape(-1), zero_division=0)\n",
    "    f1 = f1_score(y_true.reshape(-1), preds.reshape(-1), zero_division=0)\n",
    "    aucs = [safe_auc(y_true[:, i], probs[:, i]) for i in range(y_true.shape[1])]\n",
    "    return {\n",
    "        \"accuracy\": acc,\n",
    "        \"precision\": precision,\n",
    "        \"recall\": recall,\n",
    "        \"f1\": f1,\n",
    "        \"auc\": float(np.nanmean(aucs)),\n",
    "        \"per_sector_auc\": aucs,\n",
    "        \"per_sector_accuracy\": [accuracy_score(y_true[:, i], preds[:, i]) for i in range(y_true.shape[1])],\n",
    "        \"per_sector_f1\": [f1_score(y_true[:, i], preds[:, i], zero_division=0) for i in range(y_true.shape[1])],\n",
    "    }\n",
    "\n",
    "results = {}\n",
    "for name, model in final_models.items():\n",
    "    probs = predict(model, X_test)\n",
    "    metrics = metric_bundle(y_test, probs)\n",
    "    results[name] = {\"probs\": probs, **metrics}\n",
    "    print(\n",
    "        f\"{name:10s} | Acc={metrics['accuracy']:.3f} | \"\n",
    "        f\"F1={metrics['f1']:.3f} | AUC={metrics['auc']:.3f}\"\n",
    "    )\n"
   ]
