    "# 4B. Convert tabular rows into [samples, nodes, features]\n",
    "def build_X(frame):\n",
    "    n = len(frame)\n",
    "    X = np.zeros((n, N_NODES, NODE_FEAT_DIM), dtype=np.float32)\n",
    "\n",
    "    for i, s in enumerate(SECTOR_NAMES):\n",
    "        X[:, i, :10] = frame[SECTOR_COLS[s]].to_numpy(dtype=np.float32)\n",
    "\n",
    "    for i, m in enumerate(MACRO_NAMES):\n",
    "        X[:, 9 + i, :3] = frame[MACRO_COLS[m]].to_numpy(dtype=np.float32)\n",
    "\n",
    "    for i, c in enumerate(COUNTRY_NAMES):\n",
    "        X[:, 13 + i, :3] = frame[COUNTRY_COLS[c]].to_numpy(dtype=np.float32)\n",
    "\n",
    "    X[:, 20, :12] = frame[GLOBAL_COLS].to_numpy(dtype=np.float32)\n",
    "    return X\n",
    "\n",
    "def build_y(frame):\n",
    "    return frame[[f\"{s}_Target\" for s in PRED_SECTORS]].to_numpy(dtype=np.float32)\n",
    "\n",
    "X_train, y_train = build_X(train_s), build_y(train_s)\n",
