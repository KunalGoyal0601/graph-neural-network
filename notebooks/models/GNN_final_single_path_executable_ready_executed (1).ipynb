    "# 3C. Chronological split\n",
    "# The master file already contains next-day targets, so no target construction\n",
    "# or additional raw-data merge is performed here.\n",
    "\n",
    "model_df = df.dropna(subset=all_feature_cols + required_targets).reset_index(drop=True)\n",
    "\n",
    "train_mask = model_df[\"Date\"] <= TRAIN_END\n",
    "val_mask = (model_df[\"Date\"] > TRAIN_END) & (model_df[\"Date\"] <= VAL_END)\n",
    "test_mask = model_df[\"Date\"] > VAL_END\n",
    "\n",
    "train = model_df.loc[train_mask].reset_index(drop=True)\n",
    "val = model_df.loc[val_mask].reset_index(drop=True)\n",
    "test = model_df.loc[test_mask].reset_index(drop=True)\n",
    "\n",
    "if len(train) == 0 or len(val) == 0 or len(test) == 0:\n",
    "    raise ValueError(f\"Empty split: train={len(train)}, val={len(val)}, test={len(test)}\")\n",
    "\n",
    "# Leakage-safe scaling: fit only on the training period.\n",
    "scaler = StandardScaler()\n",
    "scaler.fit(train[all_feature_cols])\n",
    "\n",
    "def scale_frame(x):\n",
    "    out = x.copy()\n",
    "    out[all_feature_cols] = scaler.transform(out[all_feature_cols])\n",
    "    return out\n",
    "\n",
    "train_s, val_s, test_s = map(scale_frame, [train, val, test])\n",
