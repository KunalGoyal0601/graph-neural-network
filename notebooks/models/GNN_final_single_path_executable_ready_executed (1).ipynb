    "# 9B. Edge importance heatmap\n",
    "# Gradient of the selected target score with respect to the adjacency matrix.\n",
    "def edge_saliency(model, x_np, target_idx=0):\n",
    "    model.eval()\n",
    "    x = torch.tensor(x_np[None, ...], dtype=torch.float32, device=DEVICE)\n",
    "    adj = A_hat.clone().detach().to(DEVICE).requires_grad_(True)\n",
    "\n",
    "    if isinstance(model, HGTStyleModel):\n",
    "        logits = model(x, adj, NODE_TYPES.to(DEVICE), REL.to(DEVICE))\n",
    "    else:\n",
    "        logits = model(x, adj)\n",
    "\n",
    "    score = logits[0, target_idx]\n",
    "    model.zero_grad(set_to_none=True)\n",
    "    score.backward()\n",
    "\n",
    "    grad = adj.grad.detach().abs().cpu().numpy()\n",
    "    return grad\n",
    "\n",
    "edge_grad = edge_saliency(best_model, X_test[min(0, len(X_test)-1)], target_idx=0)\n",
    "\n",
    "# Aggregate each undirected edge and place it into a sector x edge matrix,\n",
    "# matching the requested rows=sectors, columns=directed/undirected edges view.\n",
    "edge_values = []\n",
    "for u, v, rel_id, group in edge_records:\n",
    "    edge_values.append((edge_grad[u, v] + edge_grad[v, u]) / 2)\n",
    "\n",
    "sector_rows = [NI[s] for s in PRED_SECTORS]\n",
    "heat = np.zeros((len(sector_rows), len(edge_records)))\n",
    "for r, node_id in enumerate(sector_rows):\n",
    "    for j, (u, v, _, _) in enumerate(edge_records):\n",
    "        # Importance of an edge for a sector target is weighted by whether it touches\n",
    "        # the target sector; otherwise use the global edge saliency as a shared context score.\n",
    "        if node_id in (u, v):\n",
    "            heat[r, j] = edge_values[j]\n",
    "        else:\n",
    "            heat[r, j] = 0.15 * edge_values[j]\n",
    "\n",
    "# Normalize for readable plotting.\n",
    "if heat.max() > 0:\n",
    "    heat = heat / heat.max()\n",
    "\n",
    "plt.figure(figsize=(18, 6))\n",
    "plt.imshow(heat, aspect=\"auto\", interpolation=\"nearest\")\n",
    "plt.yticks(range(len(PRED_SECTORS)), [s.replace(\"NIFTY_\", \"NIFTY_\") for s in PRED_SECTORS])\n",
    "plt.xlabel(\"Edge index\")\n",
    "plt.ylabel(\"Target sector\")\n",
    "plt.title(f\"Edge Importance Heatmap — {best_model_name} (gradient-based)\", fontweight=\"bold\")\n",
    "plt.colorbar(label=\"Normalized edge importance\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
